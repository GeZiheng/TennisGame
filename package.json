{
  "name": "tennis-motion-p0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:duel": "vite --host -c vite.config.duel.ts",
    "dev:https": "node scripts/make-cert.mjs && vite --host -c vite.config.https.ts",
    "dev:duel:https": "node scripts/make-cert.mjs && vite --host -c vite.config.duel.https.ts",
    "cert": "node scripts/make-cert.mjs",
    "trust": "node scripts/trust-ca.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "node scripts/test.mjs",
    "test:signal": "node scripts/signal-smoke.mjs",
    "sim": "node scripts/sim.mjs",
    "duel-sim": "node scripts/duel-sim.mjs",
    "verify": "node scripts/verify.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "selfsigned": "^5.5.0"
  }
}
